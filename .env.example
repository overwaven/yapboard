# Yapboard configuration. Copy to .env and fill in.
# All values can also be provided as plain environment variables.

# --- required ---------------------------------------------------------------
# Token from @BotFather. Disable privacy mode (or make the bot a group admin),
# otherwise it will not see normal group messages.
BOT_TOKEN=

# --- database ---------------------------------------------------------------
DATABASE_URL=postgresql://hubbub:hubbub@db:5432/hubbub
DB_POOL_MIN=1
DB_POOL_MAX=5

# --- collector --------------------------------------------------------------
FLUSH_INTERVAL_SEC=5
FLUSH_MAX_KEYS=500

# --- behaviour --------------------------------------------------------------
PAGE_SIZE=10
TOP_COOLDOWN_SEC=10
RICH_ENABLED=true
DEFAULT_TZ=UTC
LOG_LEVEL=INFO

# Seconds a per-chat board is served from cache before re-querying.
BOARD_CACHE_TTL=10
# Minimum interval between profile (username/first name) refreshes per user.
PROFILE_REFRESH_SEC=600

# --- webhook mode (optional; leave empty for long polling) ------------------
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_PATH=/webhook
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
